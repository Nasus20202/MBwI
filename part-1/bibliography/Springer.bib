	number = {2},
	journaltitle = {Automated Software Engineering},
	shortjournal = {Autom Softw Eng},
	author = {Nguyen, Phu and Rauniyar, Ashish and Bartel, Jone and Laufer, Jan and Dalamagkas, Christos and Pohl, Klaus},
