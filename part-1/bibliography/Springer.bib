	langid = {english},
	note = {Series Title: Law, Governance and Technology Series},
	file = {Full Text:/home/nasus/Zotero/storage/YBNJK3EP/Oliveira and Figueiredo - 2024 - Artificial Intelligence Historical Context and State of the Art.pdf:application/pdf},
}

@article{ucar_comprehensive_2025,
	title = {A comprehensive survey on pose estimation and tracking in sports: methodologies, datasets, challenges, and future directions},
