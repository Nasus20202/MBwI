@misc{yang_who_2025,
	title = {Who Gets the Reward, Who Gets the Blame? Evaluation-Aligned Training Signals for Multi-{LLM} Agents},
	rights = {Creative Commons Attribution 4.0 International},
	url = {https://arxiv.org/abs/2511.10687},
	doi = {10.48550/ARXIV.2511.10687},
	shorttitle = {Who Gets the Reward, Who Gets the Blame?},
	abstract = {Large Language Models ({LLMs}) in multi-agent systems ({MAS}) have shown promise for complex tasks, yet current training methods lack principled ways to connect system-level evaluation with agent-level and message-level learning. We propose a theoretical framework that unifies cooperative game-theoretic attribution with process reward modeling to transform system evaluation into agent credit and then into response-level signals. Unlike prior approaches that rely only on attribution (e.g., Shapley) or step-level labels (e.g., {PRM}), our method produces local, signed, and credit-conserving signals. In success cases, Shapley-based credit assignment fairly allocates outcomes across agents and is refined into per-message rewards that promote cooperation while discouraging redundancy or sabotage. In failure cases, first-error localization yields repair-aware preferences that penalize harmful steps while rewarding corrective attempts. The resulting signals are bounded, cooperative, and directly compatible with reinforcement-based or preference-based post-training, providing a unified and auditable pathway from global evaluation to local supervision in {LLM} multi-agent training. Our contribution is conceptual: we present a theoretical foundation and training signals, leaving empirical validation for future work.},
	publisher = {{arXiv}},
	author = {Yang, Chih-Hsuan and Mallick, Tanwi and Chen, Le and Raghavan, Krishnan and Wells, Azton and Gueroudji, Amal and Foster, Ian T. and Thakur, Rajeev},
	urldate = {2026-03-14},
	date = {2025},
	note = {Version Number: 2},
	keywords = {Artificial Intelligence (cs.{AI}), Computation and Language (cs.{CL}), Computer Science and Game Theory (cs.{GT}), {FOS}: Computer and information sciences, Multiagent Systems (cs.{MA})},
	annotation = {Other
Withdrawing temporarily to coordinate revisions with co-authors. A revised version will be resubmitted},
}

@misc{yashwanth_multi-agent_2025,
	title = {A Multi-Agent Pokemon Tournament for Evaluating Strategic Reasoning of Large Language Models},
	rights = {Creative Commons Attribution 4.0 International},
	url = {https://arxiv.org/abs/2508.01623},
	doi = {10.48550/ARXIV.2508.01623},
	abstract = {This research presents {LLM} Pokemon League, a competitive tournament system that leverages Large Language Models ({LLMs}) as intelligent agents to simulate strategic decision-making in Pokémon battles. The platform is designed to analyze and compare the reasoning, adaptability, and tactical depth exhibited by different {LLMs} in a type-based, turn-based combat environment. By structuring the competition as a single-elimination tournament involving diverse {AI} trainers, the system captures detailed decision logs, including team-building rationale, action selection strategies, and switching decisions. The project enables rich exploration into comparative {AI} behavior, battle psychology, and meta-strategy development in constrained, rule-based game environments. Through this system, we investigate how modern {LLMs} understand, adapt, and optimize decisions under uncertainty, making Pokémon League a novel benchmark for {AI} research in strategic reasoning and competitive learning.},
